OPENAI_API_KEY=
OPENAI_BASE_URL=

# true: full console logs; false: model names and success/failure only (Release).
# This controls logs only, not Flask's debugger or automatic reload.
DEBUG=false

# Existing main model setting remains supported (OPENAI_MODEL is a legacy alias).
OPENAI_MODEL_MAIN=gpt-5.6-terra

# Set to model IDs actually supported by your provider.
# L1 defaults to MAIN; L2 defaults to MAIN. Use distinct IDs for a real upgrade.
OPENAI_MODEL_L1=
OPENAI_MODEL_L2=

# Per API attempt timeout; SDK retries can extend total elapsed time.
OPENAI_TIMEOUT_SECONDS=600

# Optional independent provider, called once after the final primary L2 fails.
# Set all three fields to enable it. Use the provider's exact model ID.
OPENAI_BACKUP_API_KEY=
OPENAI_BACKUP_BASE_URL=
OPENAI_BACKUP_MODEL=
OPENAI_BACKUP_VISION_MODELS=

# Comma-separated exact model IDs supporting image_url inputs at your provider.
# Empty or unlisted models receive text with Image IDs only (no OCR).
OPENAI_VISION_MODELS=

# Optional Jev System One L0 routing for low-risk text-only single/judgement questions.
# Missing or invalid settings safely preserve the existing L1/L2 route.
JEV_ENABLED=false
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_DIRECT_CONFIDENCE=0.990

# Startup patch for /app/ocs.user.js. Minimum question-bank timeout in seconds.
# 1 Jev (30s) + 2 Terra (600s each) + 2 Astra (600s each) + 60s margin.
# OpenAI SDK network retries are not included; increase this budget if needed.
# Each failed question-bank request is retried up to 10 times, 30s apart.
# The worker waits for all 11 attempts plus retry intervals and a 10s margin.
# Valid per-attempt timeout range: 1..195197 seconds (JS timer limit).
OCS_ANSWER_TIMEOUT_SECONDS=2490

# Enable HTTPS for the built-in server; certificate/key paths are read at startup.
# Paths are inside the container when using Docker. Relative paths use the working directory.
SSL_ENABLED=false
SSL_SERVER_CERT_FILE=/certs/ocs-llm-answer.crt
SSL_SERVER_KEY_FILE=/certs/ocs-llm-answer.key
